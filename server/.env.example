# Copy to .env and fill in. .env is gitignored and must stay that way.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
TIMEZONE=Europe/Istanbul

DATABASE_URL="postgresql://bioguard:bioguard_dev_only@localhost:5432/bioguard?schema=public"

# 32+ chars. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Mailpit locally. Swap for a real host in production.
# "smtp" delivers. Anything else records the message to the SentEmail
# outbox and stops there, which is what a demo with addresses that do
# not exist wants. Nothing in the application renders that outbox.
MAIL_DRIVER=smtp

# Mailpit, from docker-compose. Its inbox is http://localhost:8025 and
# it needs no credentials, which is why the two below are optional.
SMTP_HOST=localhost
SMTP_PORT=1025

# Required by every hosted provider, unused by Mailpit. Without them the
# transport can only talk to an open relay on localhost.
#   Gmail:  smtp.gmail.com / 465 / SMTP_SECURE=true, and an App Password
#           rather than the account password (Google Account → Security
#           → 2-Step Verification → App passwords).
#   Brevo:  smtp-relay.brevo.com / 587 / SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Implicit TLS, which is port 465. On 587 the connection starts plain
# and upgrades, and nodemailer handles that with false.
SMTP_SECURE=false

# Most providers require this to be the account SMTP authenticates as.
# Gmail will rewrite or reject anything else, so keep it equal to
# SMTP_USER.
MAIL_FROM="BioGuard <noreply@bioguard.local>"

# Seed logins. Leave blank and the seed generates random passwords and
# prints them once. Set them to fixed values for a demo whose
# credentials are published, so re-seeding does not change the logins.
SEED_ADMIN_EMAIL=admin@bioguard.local
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# Where seeded accounts are actually written to.
#
# One address per role, real if you want that role to receive mail.
# Anything left unset falls back to <role>@bioguard.local, which does not
# exist — fine for a demo, and the reason MAIL_DRIVER must not be "smtp"
# unless at least one of these is real.
#
# Two roles may not share an address: the email column is unique and it
# is the login, so the seed refuses before it writes anything.
#
# Put real values in .env, never here — this file is committed and the
# repository is public.
# SEED_MANAGER_EMAIL=
# SEED_ALERTS_EMAIL=
# SEED_STAFF_EMAIL=
#
# Comma-separated, in order. Four engineers are seeded; supply as many
# real addresses as there are real people and the rest fall back.
# SEED_ENGINEER_EMAILS=

# --- Serverless deployments only (Vercel). Leave unset elsewhere. ---
#
# "worker" (the default) runs the pg-boss scheduler in-process, which is
# what the Docker image does. "cron" is for a platform that freezes the
# function after each response: nothing there can poll a queue, so the
# platform's scheduler calls /api/cron/sweep instead.
# SCHEDULER_MODE=cron
#
# The secret that endpoint requires. 16+ chars, and the process refuses
# to boot in cron mode without it. Generate with: openssl rand -hex 32
# CRON_SECRET=
#
# Rate-limit counters shared across instances instead of held in one
# process's memory, which on serverless would divide every limit by the
# number of warm instances. See server/src/lib/rateLimitStore.ts.
# RATE_LIMIT_STORE=postgres
#
# One connection per instance, leaving the multiplexing to the platform
# pooler. Unset means pg's default of 10, which is right for a container.
# DB_POOL_MAX=1
#
# Migrations and seeding only. Prisma Migrate takes a session-scoped
# advisory lock, which a transaction pooler cannot carry between
# statements — the command hangs instead of failing. Point this at a
# session-mode or direct connection and leave DATABASE_URL on the pooler
# the application wants. Unset, the CLI just uses DATABASE_URL.
# MIGRATE_DATABASE_URL=
#
# --- Photo storage (optional). Leave unset and the upload control is
# --- simply absent; nothing else changes.
#
# A private Supabase Storage bucket named equipment-photos. Reads go
# through short-lived signed links, so BioGuard's own permission check
# stays the thing that decides who sees a device.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=
