# Copy to .env and fill in. .env is gitignored and must stay that way.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
TIMEZONE=Europe/Istanbul

DATABASE_URL="postgresql://bioguard:bioguard_dev_only@localhost:5432/bioguard?schema=public"

# 32+ chars. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Mailpit locally. Swap for a real host in production.
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="BioGuard <noreply@bioguard.local>"

# Printed once by the seed script if left blank.
SEED_ADMIN_EMAIL=admin@bioguard.local
SEED_ADMIN_PASSWORD=
