# Copy to .env and fill in. .env is gitignored and must stay that way.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
TIMEZONE=Europe/Istanbul

DATABASE_URL="postgresql://bioguard:bioguard_dev_only@localhost:5432/bioguard?schema=public"

# 32+ chars. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Mailpit locally. Swap for a real host in production.
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="BioGuard <noreply@bioguard.local>"

# Seed logins. Leave blank and the seed generates random passwords and
# prints them once. Set them to fixed values for a demo whose
# credentials are published, so re-seeding does not change the logins.
SEED_ADMIN_EMAIL=admin@bioguard.local
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# --- Serverless deployments only (Vercel). Leave unset elsewhere. ---
#
# "worker" (the default) runs the pg-boss scheduler in-process, which is
# what the Docker image does. "cron" is for a platform that freezes the
# function after each response: nothing there can poll a queue, so the
# platform's scheduler calls /api/cron/sweep instead.
# SCHEDULER_MODE=cron
#
# The secret that endpoint requires. 16+ chars, and the process refuses
# to boot in cron mode without it. Generate with: openssl rand -hex 32
# CRON_SECRET=
#
# Rate-limit counters shared across instances instead of held in one
# process's memory, which on serverless would divide every limit by the
# number of warm instances. See server/src/lib/rateLimitStore.ts.
# RATE_LIMIT_STORE=postgres
#
# One connection per instance, leaving the multiplexing to the platform
# pooler. Unset means pg's default of 10, which is right for a container.
# DB_POOL_MAX=1
#
# Migrations and seeding only. Prisma Migrate takes a session-scoped
# advisory lock, which a transaction pooler cannot carry between
# statements — the command hangs instead of failing. Point this at a
# session-mode or direct connection and leave DATABASE_URL on the pooler
# the application wants. Unset, the CLI just uses DATABASE_URL.
# MIGRATE_DATABASE_URL=
#
# --- Photo storage (optional). Leave unset and the upload control is
# --- simply absent; nothing else changes.
#
# A private Supabase Storage bucket named equipment-photos. Reads go
# through short-lived signed links, so BioGuard's own permission check
# stays the thing that decides who sees a device.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=
