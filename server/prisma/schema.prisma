// BioGuard — biomedical equipment maintenance management
//
// Design notes that are easy to lose later:
//   * nextDueAt is a stored, indexed column, never derived on read. The
//     nightly scheduler must be one indexed query, not a full scan.
//   * operationalStatus has no "maintenance due" member. Due state is
//     derived from nextDueAt, so a device can be under repair AND
//     overdue at the same time, which is the truth.
//   * NotificationDispatch is the idempotency table. Its unique
//     constraint is the only thing stopping duplicate reminders.
//   * publicToken, not the asset tag, is what a QR code encodes. Asset
//     tags are sequential and would let anyone enumerate the estate.
//   * Primary keys are UUIDv7, generated by Prisma rather than by the
//     database. Postgres only gained a built-in uuidv7() in version 18,
//     and hosted platforms lag behind — Supabase is still on 17. The
//     index-locality benefit comes from the value's bit layout, not
//     from where it is generated, so this costs nothing and runs
//     anywhere.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The URL lives in prisma.config.ts from Prisma 7 onwards; the client
  // receives it through a driver adapter in src/lib/prisma.ts.
}

enum Role {
  ADMIN
  ENGINEER
  STAFF
  MANAGER
  /// Triages incoming alerts: acknowledges receipt and assigns an
  /// engineer. Deliberately separate from MANAGER, which means oversight
  /// of the preventive programme and drives what oversees() unlocks.
  HEAD_OF_ALERTS
}

enum Criticality {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum OperationalStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  UNDER_REPAIR
  AWAITING_PARTS
  OUT_OF_SERVICE
  RETIRED
}

enum ScheduleMode {
  GRACE
  ANCHORED
}

enum IntervalSource {
  MANUFACTURER
  HOSPITAL_POLICY
  RISK_BASED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  EMERGENCY
  CALIBRATION
  INSPECTION
  SAFETY_TEST
}

/// Shared by alerts and the work orders raised from them.
enum Priority {
  EMERGENCY
  MEDIUM
  LOW
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

/// The ladder a part climbs, plus the exit for one that turns out not to
/// be needed. Without CANCELLED the only ways to retire a mistaken line
/// would be deleting it — losing the record that it was ever ordered — or
/// marking it installed, which is a lie.
enum PartStatus {
  REQUIRED
  REQUESTED
  ORDERED
  RECEIVED
  INSTALLED
  CANCELLED
}

enum WorkOrderStatus {
  INVESTIGATING
  AWAITING_PARTS
  IN_REPAIR
  COMPLETED
  CLOSED
  CANCELLED
}

enum NotifyLevel {
  INFO
  WARNING
  URGENT
  DUE
  OVERDUE
}

enum SweepTrigger {
  SCHEDULED
  MANUAL
}

// ---------------------------------------------------------------- users

model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  email             String    @unique
  passwordHash      String
  fullName          String
  role              Role
  departmentId      String?   @db.Uuid
  department        Department? @relation(fields: [departmentId], references: [id])
  isActive          Boolean   @default(true)
  // Brute-force controls
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  // Any session issued before this instant is rejected.
  passwordChangedAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions          Session[]
  resetTokens       PasswordResetToken[]
  assignedEquipment Equipment[]         @relation("ResponsibleEngineer")
  maintenanceLogged MaintenanceRecord[]
  notifications     Notification[]
  auditEntries      AuditLog[]
  notes             Note[]              @relation("NoteAuthor")
  savedViews        SavedView[]         @relation("SavedViewOwner")

  raisedAlerts       Alert[]     @relation("AlertRaiser")
  acknowledgedAlerts Alert[]     @relation("AlertAcknowledger")
  assignedAlerts     Alert[]     @relation("AlertAssignee")
  workOrders         WorkOrder[] @relation("WorkOrderEngineer")
  closedWorkOrders   WorkOrder[] @relation("WorkOrderCloser")

  @@index([role, isActive])
}

model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the cookie value. The raw token is never stored, so a
  // database leak does not hand over live sessions.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ------------------------------------------------------------ locations

model Department {
  id        String      @id @default(uuid(7)) @db.Uuid
  name      String      @unique
  equipment Equipment[]
  users     User[]
}

model Building {
  id    String @id @default(uuid(7)) @db.Uuid
  name  String @unique
  rooms Room[]
}

model Room {
  id         String      @id @default(uuid(7)) @db.Uuid
  buildingId String      @db.Uuid
  building   Building    @relation(fields: [buildingId], references: [id])
  floor      Int
  code       String
  equipment  Equipment[]

  @@unique([buildingId, floor, code])
}

// ------------------------------------------------------------ equipment

model EquipmentCategory {
  id              String      @id @default(uuid(7)) @db.Uuid
  name            String      @unique
  defaultInterval Int
  equipment       Equipment[]
}

model Manufacturer {
  id        String      @id @default(uuid(7)) @db.Uuid
  name      String      @unique
  equipment Equipment[]
}

model Equipment {
  id             String            @id @default(uuid(7)) @db.Uuid
  tag            String            @unique // BG-EQ-000123, for humans
  publicToken    String            @unique // opaque, what the QR encodes
  assetNo        String            @unique
  name           String
  categoryId     String            @db.Uuid
  category       EquipmentCategory @relation(fields: [categoryId], references: [id])
  manufacturerId String            @db.Uuid
  manufacturer   Manufacturer      @relation(fields: [manufacturerId], references: [id])
  model          String
  serialNo       String

  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])
  roomId       String?    @db.Uuid
  room         Room?      @relation(fields: [roomId], references: [id])

  criticality       Criticality
  operationalStatus OperationalStatus @default(OPERATIONAL)
  engineerId        String?           @db.Uuid
  engineer          User?             @relation("ResponsibleEngineer", fields: [engineerId], references: [id])

  // --- maintenance schedule ---
  intervalDays      Int
  intervalSource    IntervalSource @default(MANUFACTURER)
  scheduleMode      ScheduleMode   @default(GRACE)
  graceDaysOverride Int?
  lastCompletedAt   DateTime?      @db.Date
  nextDueAt         DateTime?      @db.Date

  /// The object key in the photo bucket, not a URL. Links to a private
  /// bucket are signed and expire, so storing one would store something
  /// that stops working.
  photoPath      String?
  installedAt    DateTime? @db.Date
  purchasedAt    DateTime? @db.Date
  purchasePrice  Decimal?  @db.Decimal(12, 2)
  warrantyEndsAt DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenance   MaintenanceRecord[]
  dispatches    NotificationDispatch[]
  notifications Notification[]
  alerts        Alert[]
  workOrders    WorkOrder[]

  @@index([nextDueAt])
  @@index([departmentId, operationalStatus])
  @@index([criticality, nextDueAt])
}

model MaintenanceRecord {
  id          String          @id @default(uuid(7)) @db.Uuid
  equipmentId String          @db.Uuid
  equipment   Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  type        MaintenanceType
  completedOn DateTime        @db.Date
  engineerId  String          @db.Uuid
  engineer    User            @relation(fields: [engineerId], references: [id])

  problem       String?
  findings      String?
  workPerformed String
  cost          Decimal? @db.Decimal(12, 2)
  downtimeHours Int      @default(0)

  // Schedule audit. Without these four you can see that work happened
  // but not whether the programme is slipping.
  satisfiedDueDate DateTime? @db.Date
  latenessDays     Int?
  rebased          Boolean   @default(false)
  nextDueAfter     DateTime? @db.Date

  createdAt DateTime @default(now())

  /// Set when this record was written by closing a work order, which is
  /// how corrective work reaches the device's history.
  workOrder WorkOrder?

  @@index([equipmentId, completedOn])
}

// -------------------------------------------------------- notifications

model NotificationDispatch {
  id          String    @id @default(uuid(7)) @db.Uuid
  equipmentId String    @db.Uuid
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  dueDate     DateTime  @db.Date
  threshold   Int
  sentAt      DateTime  @default(now())

  @@unique([equipmentId, dueDate, threshold])
}

model Notification {
  id          String      @id @default(uuid(7)) @db.Uuid
  recipientId String      @db.Uuid
  recipient   User        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  equipmentId String?     @db.Uuid
  equipment   Equipment?  @relation(fields: [equipmentId], references: [id])
  alertId     String?     @db.Uuid
  alert       Alert?      @relation(fields: [alertId], references: [id], onDelete: Cascade)
  level       NotifyLevel
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime    @default(now())

  @@index([recipientId, readAt])
}

/// Delivered mail, kept so recipients can read what was sent without a
/// real mailbox. The "db" mail driver writes here instead of to SMTP,
/// which also avoids sending to the fictional @bioguard.local addresses
/// the demo data uses.
model SentEmail {
  id        String   @id @default(uuid(7)) @db.Uuid
  to        String
  subject   String
  body      String
  sentAt    DateTime @default(now())
  readAt    DateTime?

  @@index([to, sentAt])
}

// ------------------------------------------------------------ audit log

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String   @db.Uuid
  // Field allowlist output only. Never a whole row: User rows carry
  // passwordHash and it must not reach this table.
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([createdAt])
}

// ------------------------------------------------------- scheduler runs

/// One completed run of the nightly sweep.
///
/// The point of this table is the rows that are *missing*. A process that
/// has crashed cannot write its own error row, so liveness is judged by
/// the absence of a recent SCHEDULED run rather than by error reporting.
/// `error` is a best-effort second signal for the case where the sweep
/// fails but the process survives.
///
/// Only the nightly job writes here. The admin simulation deliberately
/// does not: it would add a row per simulated day and make a hand-run
/// look like a healthy cron.
model SweepRun {
  id         String       @id @default(uuid(7)) @db.Uuid
  ranFor     DateTime     @db.Date
  trigger    SweepTrigger @default(SCHEDULED)
  scanned    Int
  sent       Int
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  error      String?

  @@index([trigger, startedAt])
}

// ----------------------------------------------- alerts and work orders

/// A fault reported by ward staff.
///
/// The counterpart to the preventive programme: preventive work is
/// scheduled, this is what happens when a device breaks between services.
/// It always names a registered device, so a fault lands in that device's
/// history rather than in a parallel universe of free-text labels.
///
/// `seq` is an autoincrement column and the display number (ALT-2026-000123)
/// is derived from it in the API. A counted-rows or read-then-write scheme
/// would hand two nurses the same number under load.
model Alert {
  id          String      @id @default(uuid(7)) @db.Uuid
  seq         Int         @unique @default(autoincrement())
  equipmentId String      @db.Uuid
  equipment   Equipment   @relation(fields: [equipmentId], references: [id])
  raisedById  String      @db.Uuid
  raisedBy    User        @relation("AlertRaiser", fields: [raisedById], references: [id])
  description String
  priority    Priority
  status      AlertStatus @default(OPEN)

  openedAt         DateTime  @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?   @db.Uuid
  acknowledgedBy   User?     @relation("AlertAcknowledger", fields: [acknowledgedById], references: [id])
  assignedToId     String?   @db.Uuid
  assignedTo       User?     @relation("AlertAssignee", fields: [assignedToId], references: [id])
  assignedAt       DateTime?
  resolvedAt       DateTime?
  cancelledReason  String?

  updatedAt DateTime @updatedAt

  workOrder     WorkOrder?
  notifications Notification[]

  notes Note[]

  @@index([status, priority])
  @@index([assignedToId, status])
  @@index([equipmentId, openedAt])
  @@index([raisedById, openedAt])
}

/// The engineering response to an alert: one per alert.
///
/// Its status drives the device's operationalStatus, which is what keeps
/// the estate view honest — a device under repair says so on the
/// equipment list without anyone remembering to set it.
///
/// Closing one writes a MaintenanceRecord of type CORRECTIVE. Because only
/// PREVENTIVE work resets the schedule, a repair never buys the device
/// another maintenance cycle.
model WorkOrder {
  id      String @id @default(uuid(7)) @db.Uuid
  seq     Int    @unique @default(autoincrement())
  alertId String @unique @db.Uuid
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  /// Denormalised from the alert so work-order queries index directly
  /// rather than joining through it.
  equipmentId String    @db.Uuid
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  engineerId  String    @db.Uuid
  engineer    User      @relation("WorkOrderEngineer", fields: [engineerId], references: [id])

  status   WorkOrderStatus @default(INVESTIGATING)
  priority Priority

  findings        String?
  diagnosis       String?
  repairActions   String?
  finalResolution String?
  /// Engineer time on this repair, recorded when it is closed. Separate
  /// from downtime, which is how long the device was unavailable: an
  /// hour of work can sit inside three weeks of waiting for a part.
  labourHours     Decimal? @db.Decimal(5, 2)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  closedAt    DateTime?
  closedById  String?   @db.Uuid
  closedBy    User?     @relation("WorkOrderCloser", fields: [closedById], references: [id])

  maintenanceRecordId String?            @unique @db.Uuid
  maintenanceRecord   MaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id])

  parts WorkOrderPart[]
  notes Note[]

  @@index([status, priority])
  @@index([engineerId, status])
  @@index([equipmentId])
}

/// A named set of list filters, kept by one person for themselves.
///
/// The query is stored exactly as the URL held it, because that is
/// already the application's description of a filtered list — the
/// equipment page has put its filters in the address bar since it was
/// written. Replaying one is therefore no more powerful than typing the
/// same URL: every list endpoint parses it with a strict schema and
/// rejects anything it does not recognise.
///
/// Private to their owner. A shared view would need a story about who
/// may see which departments, and the scoping rules already answer that
/// per request rather than per saved string.
model SavedView {
  id       String @id @default(uuid(7)) @db.Uuid
  name     String
  /// Which list it belongs to: "equipment", "alerts", "work-orders".
  resource String
  /// The query string, without the leading question mark.
  query    String

  ownerId String @db.Uuid
  owner   User   @relation("SavedViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ownerId, resource, name])
  @@index([ownerId, resource])
}

/// A comment on an alert or a work order.
///
/// Deliberately not the same thing as findings, diagnosis or repair
/// actions, which are the engineer's account of the fault and belong to
/// the record. A note is the conversation around it — a nurse adding
/// that the fault only happens on mains power, a manager asking whether
/// the loan pump arrived. Mixing the two would put hearsay in a document
/// kept for audit.
///
/// Exactly one of alertId and workOrderId is set. That is enforced in
/// the API rather than by a check constraint, so the schema Prisma
/// generates and the schema in the database cannot drift apart.
model Note {
  id   String @id @default(uuid(7)) @db.Uuid
  body String

  authorId String @db.Uuid
  author   User   @relation("NoteAuthor", fields: [authorId], references: [id])

  alertId String? @db.Uuid
  alert   Alert?  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  workOrderId String?    @db.Uuid
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([alertId, createdAt])
  @@index([workOrderId, createdAt])
}

/// A part needed for a repair, and how far along it is.
///
/// A line item rather than a catalogue entry: this records what one job
/// needed, not what the hospital stocks. Each step carries its own
/// timestamp, because "ordered three weeks ago" is the question people
/// actually ask of a stalled repair.
model WorkOrderPart {
  id          String     @id @default(uuid(7)) @db.Uuid
  workOrderId String     @db.Uuid
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  name        String
  partNumber  String?
  quantity    Int        @default(1)
  status      PartStatus @default(REQUIRED)
  notes       String?

  requestedAt DateTime?
  orderedAt   DateTime?
  receivedAt  DateTime?
  installedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workOrderId, status])
}

// ------------------------------------------------------- rate limiting

/// One rate-limit window, shared across processes.
///
/// express-rate-limit defaults to an in-memory store, which is correct
/// for exactly one long-lived process. On a serverless platform every
/// concurrent invocation gets its own memory, so the login and password
/// reset limits SECURITY.md documents would divide by the number of
/// warm instances and protect nobody — while still reporting healthy
/// numbers, which is the worst way for a control to fail.
///
/// Keyed by whatever the limiter's keyGenerator produces (client IP, or
/// an account identifier), prefixed per limiter so the five of them
/// cannot collide. Expired rows are harmless and swept lazily; see
/// lib/rateLimitStore.ts.
model RateLimitHit {
  key       String   @id
  hits      Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
